# Copy to .env in the repository root. The backend reads LEARNLOOP_* and the provider keys.
# Never commit a filled-in copy.

LEARNLOOP_DATA_DIR=data
LEARNLOOP_AUTO_SEED=1
LEARNLOOP_WORKER_ENABLED=1

# Optional. Leave unset to use the local fixture and deterministic providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MODEL_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# Set to 1 only when you intend to spend money on a live provider call.
LEARNLOOP_LIVE_PROVIDERS=0
# Per-frame SAM video rate from Meta's pricing page. Unset leaves recovery cost unknown; frame limits still apply.
# LEARNLOOP_SAM_PRICE_PER_FRAME_USD=
